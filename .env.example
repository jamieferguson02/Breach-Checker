# Copy this file to .env and fill in your own values.
# Never commit .env - it is listed in .gitignore.

# Your Intelligence X API key (https://intelx.io/account?tab=developer)
INTELX_KEY=your_api_key_here

# Optional: override the API endpoint set in config.yaml
INTELX_BASE_URL=https://free.intelx.io/
